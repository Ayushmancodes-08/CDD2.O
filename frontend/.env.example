# Free Gmail SMTP Configuration (500 emails/day, completely free)
#
# HOW TO GET YOUR GOOGLE APP PASSWORD (30 seconds):
# 1. Open your Google Account (https://myaccount.google.com/)
# 2. Make sure 2-Step Verification is turned ON (Security tab)
# 3. Go to "App passwords" (https://myaccount.google.com/apppasswords)
# 4. Enter app name "IIC PMEC Portal" and click Create
# 5. Copy the generated 16-character password below (without spaces)

GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# (Optional) Email address where visitor inquiries should be delivered
# Defaults to GMAIL_USER if left blank
ADMIN_NOTIFICATION_EMAIL="your-email@gmail.com"
